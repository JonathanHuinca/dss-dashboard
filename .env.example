# ==============================================================================
# DSS Dashboard UCT — Plantilla de Configuración de Entorno (.env.example)
# Sistema de Apoyo a la Toma de Decisiones — Campus San Francisco
# ==============================================================================

# Entorno y Zona Horaria
ENVIRONMENT=development
TZ=America/Santiago

# Base de Datos SQL Server (Contenedor uct_sqlserver)
MSSQL_SA_PASSWORD=Reemplazar_Password_SA_Segura_123!
MSSQL_USUARIO_APP=uct_app
MSSQL_CLAVE_APP=Reemplazar_Password_App_Segura_456!

# Cadenas de Conexión de Aplicación (Usuario con privilegios mínimos sobre uct_dashboard)
DATABASE_URL=mssql+aioodbc://uct_app:Reemplazar_Password_App_Segura_456!@db:1433/uct_dashboard?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DATABASE_URL_SYNC=mssql+pyodbc://uct_app:Reemplazar_Password_App_Segura_456!@db:1433/uct_dashboard?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Seguridad y Criptografía (Ley N° 21.719 de Protección de Datos Personales)
# Generar claves criptográficas reales:
# JWT: openssl rand -hex 32
# Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET_KEY=cambia-esto-por-un-secreto-hex-largo-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

SALT_PERSON_SECRET=cambia-esto-por-salt-sha256-persona
SALT_VEHICLE_SECRET=cambia-esto-por-salt-sha256-vehiculo
FERNET_KEY=cambia-esto-por-fernet-key-valida-base64=

# Inteligencia Artificial y LLM
GEMINI_API_KEY=AIzaSy_Reemplazar_Por_Tu_Gemini_API_Key
MODELO_GEMINI_POR_DEFECTO=gemini-3.5-flash-lite

# Planificador Interno (APScheduler)
PLANIFICADOR_ACTIVO=false

# Inicialización y Carga Demo (Solo activo si ENVIRONMENT=development)
SEMILLA_DEMO=true
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=

# Seguridad de Red y Control Perimetral
ENABLE_IP_WHITELIST=false
ALLOWED_SUBNETS=10.20.0.0/16,127.0.0.1/32

# URL Pública del Frontend Institucional
FRONTEND_URL=http://localhost:3000

# Servidor de Correo Institucional SMTP (Notificaciones y Activación de Cuentas)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@uct.cl
SMTP_PASSWORD=tu_password_smtp
SMTP_FROM_EMAIL=notificaciones@uct.cl
SMTP_FROM_NAME=DSS Campus San Francisco - UCT
SMTP_USE_TLS=true

# Integración ANPR HikCentral OpenAPI
HIKCENTRAL_BASE_URL=https://hikcentral.uct.cl
HIKCENTRAL_APP_KEY=
HIKCENTRAL_APP_SECRET=
HIKCENTRAL_CA_BUNDLE=
HIKCENTRAL_ESPACIOS={"1": "REGION_BIBLIOTECA", "2": "REGION_ESTACIONAMIENTO"}

# Configuración de Modelos Predictivos y Calendario Académico
HORA_ENTRENAMIENTO_DIARIO=06:00
MINIMO_EVENTOS_CALENDARIO=20

# Credenciales para scripts de prueba en backend/scripts (no usar valores reales en el repositorio)
PRUEBA_ADMIN_EMAIL=
PRUEBA_ADMIN_PASSWORD=
PRUEBA_ANALISTA_EMAIL=
PRUEBA_ANALISTA_PASSWORD=

# Botones de acceso rapido del login (solo `npm run dev`); definir en frontend/.env.local, no aqui
# VITE_DEMO_ADMIN_PASSWORD=
# VITE_DEMO_USER_PASSWORD=
